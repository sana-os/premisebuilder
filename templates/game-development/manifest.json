{
  "id": "game-development",
  "family": "game",
  "version": "0.1.0",
  "protocolVersion": "0.1.0",
  "defaultLocale": "ja",
  "locales": [
    "en",
    "ja",
    "es",
    "zh-hans",
    "zh-hant",
    "pt-br",
    "fr",
    "de",
    "ar"
  ],
  "questionSet": "questions/{locale}.json",
  "rules": "rules.json",
  "mappings": "mappings.json",
  "responseTypes": [
    "single-choice",
    "multi-choice",
    "short-text",
    "long-text"
  ],
  "projectPhases": [
    "new_build",
    "redesign",
    "extension",
    "repair"
  ],
  "categoryOrder": [
    "project.intent",
    "game.players",
    "game.rules",
    "game.scope",
    "game.presentation",
    "game.technology",
    "game.accessibility",
    "game.boundaries",
    "game.delivery",
    "game.validation"
  ],
  "categoryCount": 10,
  "questionCount": 40,
  "participantRolePresets": [
    "developer",
    "end_user",
    "requester",
    "decision_owner",
    "designer",
    "maintainer",
    "security_compliance",
    "mixed",
    "unknown"
  ],
  "provenance": {
    "contributionMode": "per-answer",
    "persistentAnswerContext": true,
    "allowPerAnswerContextOverride": true,
    "requiredContributionFields": [
      "perspectiveRef",
      "recordedByRef",
      "speakingAs",
      "captureMethod",
      "authority",
      "confirmation",
      "value",
      "recordedAt"
    ],
    "inferenceConfirmation": "unconfirmed",
    "resolutionMode": "separate",
    "autoResolveFromContribution": false,
    "suggestResolutionFromAuthorizedContribution": true,
    "requireExplicitResolutionAction": true,
    "defaultAcceptedResolutionAuthorities": [
      "decision_owner"
    ]
  },
  "resolution": {
    "defaultStatus": "provisional",
    "userSelectableStatuses": [
      "confirmed",
      "provisional",
      "unspecified",
      "proposal_requested",
      "delegated",
      "not_applicable"
    ],
    "derivedStatus": "conflict"
  }
}
