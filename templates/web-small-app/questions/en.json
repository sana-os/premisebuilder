{
  "templateId": "web-small-app",
  "templateVersion": "0.1.0",
  "locale": "en",
  "direction": "ltr",
  "template": {
    "name": "Websites & Small Web Apps",
    "summary": "Define the working premise for a website or a clearly bounded web application."
  },
  "answerContext": {
    "answeringFrom": "Answering from",
    "recordedBy": "Recorded by",
    "speakingAs": "Speaking as",
    "captureMethod": "How this was obtained",
    "authority": "Authority for this answer",
    "confirmation": "Source confirmation",
    "changeForQuestion": "Change for this question",
    "multiplePerspectives": "Add another perspective"
  },
  "resolutionStates": [
    {
      "value": "confirmed",
      "label": "Confirmed",
      "description": "Use this as an accepted project premise."
    },
    {
      "value": "provisional",
      "label": "Use provisionally",
      "description": "Use this for now, but keep it visibly open to revision."
    },
    {
      "value": "unspecified",
      "label": "Not decided",
      "description": "Leave this open. Do not let an AI silently fill it in."
    },
    {
      "value": "proposal_requested",
      "label": "Ask for a proposal",
      "description": "Request alternatives or a recommendation without treating one as chosen."
    },
    {
      "value": "delegated",
      "label": "Delegate within bounds",
      "description": "Allow the implementer or AI to decide within the stated limits and report the choice."
    },
    {
      "value": "not_applicable",
      "label": "Does not apply",
      "description": "Mark this question as outside the project."
    }
  ],
  "messages": {
    "validation.provenanceRequired": "Choose whose perspective this answer represents and who recorded it.",
    "validation.speakingRoleMismatch": "The selected speaking role is not assigned to that participant.",
    "validation.inferenceUnconfirmed": "An inferred answer must remain unconfirmed until an authorized person verifies it.",
    "validation.resolutionAuthorityRequired": "Confirming this premise requires an authorized decision source.",
    "validation.exclusiveChoice": "This option cannot be combined with other selections.",
    "validation.noteRequired": "Add a short note to explain this selection.",
    "validation.selectionLimit": "Reduce the number of selected options.",
    "review.authRuntime": "Authentication is in scope, but the selected runtime may require an external or server component.",
    "review.paymentHandling": "Payment-related data is in scope. Confirm who processes it and whether the project may store any of it.",
    "review.analyticsPrivacy": "Analytics or telemetry is in scope. Recheck the privacy boundary, consent, and prohibited practices."
  },
  "categories": [
    {
      "id": "project.intent",
      "label": "Project intent",
      "description": "Define what is being built, why it matters, and the current phase.",
      "perspectiveHint": "Prefer the requester or decision owner. Record a developer's interpretation as a separate contribution."
    },
    {
      "id": "audience.context",
      "label": "Audience & context",
      "description": "Describe the people who will use the result and the conditions around use.",
      "perspectiveHint": "When possible, record actual end-user input separately from assumptions made by the project team."
    },
    {
      "id": "scope.deliverables",
      "label": "Scope & deliverables",
      "description": "Make the release boundary, required surfaces, and exclusions visible.",
      "perspectiveHint": "A requester can describe desired scope; a developer can separately record feasibility and implementation consequences."
    },
    {
      "id": "content.data",
      "label": "Content & data",
      "description": "Clarify content responsibility and how user-entered data may be handled.",
      "perspectiveHint": "Use the content owner for editorial facts and an authorized technical or privacy source for data handling."
    },
    {
      "id": "design.interaction",
      "label": "Design & interaction",
      "description": "Capture visual direction and interaction preferences without confusing them with hard constraints.",
      "perspectiveHint": "Keep end-user observations, requester preferences, and designer recommendations as separate contributions."
    },
    {
      "id": "technology.runtime",
      "label": "Technology & runtime",
      "description": "Define stack flexibility, runtime boundaries, browser support, and external services.",
      "perspectiveHint": "A developer may recommend an implementation. Record whether that recommendation is advisory or an authorized technical decision."
    },
    {
      "id": "quality.accessibility",
      "label": "Quality & accessibility",
      "description": "Set the expected level of accessibility, responsive behavior, and performance.",
      "perspectiveHint": "Combine observed user needs with technical or compliance authority; do not replace one with the other."
    },
    {
      "id": "risk.boundaries",
      "label": "Risks & boundaries",
      "description": "State what must not happen and which failures would be costly.",
      "perspectiveHint": "Confirm hard prohibitions with a decision owner or relevant domain authority."
    },
    {
      "id": "delivery.operations",
      "label": "Delivery & operations",
      "description": "Define hosting, deployment, maintenance, and handoff expectations.",
      "perspectiveHint": "Record the maintainer's operational needs separately from the developer's preferred workflow."
    },
    {
      "id": "acceptance.validation",
      "label": "Acceptance & validation",
      "description": "Define who accepts the work and what evidence will count as complete.",
      "perspectiveHint": "The final resolution should come from the person or group authorized to accept the release."
    }
  ],
  "questions": [
    {
      "questionId": "project.intent.project_kind",
      "category": "project.intent",
      "order": 10,
      "prompt": "What are you building?",
      "help": "Choose the closest primary shape for this release.",
      "responseType": "single-choice",
      "choices": [
        { "value": "informational_site", "label": "Informational website" },
        { "value": "landing_page", "label": "Landing page" },
        { "value": "portfolio", "label": "Portfolio" },
        { "value": "public_content_site", "label": "Public content site" },
        { "value": "browser_local_utility", "label": "Browser-local utility" },
        { "value": "small_web_app", "label": "Small web application" },
        { "value": "mixed", "label": "A mixed release", "requiresNote": true }
      ]
    },
    {
      "questionId": "project.intent.primary_outcome",
      "category": "project.intent",
      "order": 20,
      "prompt": "What is the primary outcome this release should enable?",
      "help": "Choose the outcome that should win when tradeoffs are necessary.",
      "responseType": "single-choice",
      "choices": [
        { "value": "explain_information", "label": "Help people understand information" },
        { "value": "generate_leads", "label": "Generate inquiries or leads" },
        { "value": "showcase_work", "label": "Showcase work or credentials" },
        { "value": "complete_workflow", "label": "Let users complete a workflow" },
        { "value": "provide_utility", "label": "Provide a focused tool or utility" },
        { "value": "publish_content", "label": "Publish or organize content" },
        { "value": "validate_idea", "label": "Validate an idea or prototype" },
        { "value": "other", "label": "Another outcome", "requiresNote": true }
      ]
    },
    {
      "questionId": "project.intent.current_phase",
      "category": "project.intent",
      "order": 30,
      "prompt": "What phase is the project in?",
      "help": "This changes whether the work should create, preserve, extend, or repair existing behavior.",
      "responseType": "single-choice",
      "choices": [
        { "value": "new_build", "label": "New build" },
        { "value": "redesign", "label": "Redesign" },
        { "value": "extension", "label": "Extension" },
        { "value": "repair", "label": "Repair" }
      ]
    },
    {
      "questionId": "project.intent.success_evidence",
      "category": "project.intent",
      "order": 40,
      "prompt": "What observable result would make this release worthwhile?",
