      "choices": [
        { "value": "general_public", "label": "General public" },
        { "value": "prospective_customers", "label": "Prospective customers" },
        { "value": "existing_customers", "label": "Existing customers" },
        { "value": "internal_staff", "label": "Internal staff" },
        { "value": "professionals", "label": "Professionals or specialists" },
        { "value": "creators", "label": "Creators or contributors" },
        { "value": "students_researchers", "label": "Students or researchers" },
        { "value": "defined_community", "label": "A defined community" },
        { "value": "mixed", "label": "Several groups equally", "requiresNote": true },
        { "value": "other", "label": "Another audience", "requiresNote": true }
      ]
    },
    {
      "questionId": "audience.context.relationship",
      "category": "audience.context",
