  "categories": [
    {
      "id": "project.intent",
      "label": "项目意图",
      "description": "明确要构建什么、为何重要，以及当前阶段。",
      "perspectiveHint": "优先记录需求提出者或决策负责人的意见。开发者的理解应作为单独的来源回答记录。"
    },
    {
      "id": "audience.context",
      "label": "受众与场景",
      "description": "描述结果的使用者及其使用条件。",
      "perspectiveHint": "尽可能将实际最终用户的输入与项目团队的假设分别记录。"
    },
    {
      "id": "scope.deliverables",
      "label": "范围与交付物",
      "description": "明确发行范围、必需界面与排除事项。",
      "perspectiveHint": "需求提出者可以描述期望范围；开发者应单独记录可行性与实施影响。"
    },
    {
      "id": "content.data",
      "label": "内容与数据",
      "description": "明确内容责任，以及如何处理用户输入的数据。",
      "perspectiveHint": "编辑事实由内容负责人提供；数据处理由有权的技术或隐私负责人确认。"
    },
    {
      "id": "design.interaction",
      "label": "设计与交互",
      "description": "记录视觉方向与交互偏好，避免将其混同于硬性限制。",
      "perspectiveHint": "分别保留最终用户的观察、需求提出者的偏好与设计师的建议。"
    },
    {
      "id": "technology.runtime",
      "label": "技术与运行环境",
      "description": "明确技术栈的灵活性、运行边界、浏览器支持与外部服务。",
      "perspectiveHint": "开发者可以推荐实现方式。请记录该建议是参考意见，还是经授权的技术决定。"
    },
    {
      "id": "quality.accessibility",
      "label": "质量与无障碍",
      "description": "确定无障碍、响应式表现与性能的预期水平。",
      "perspectiveHint": "结合观察到的用户需求与技术或合规权限，不能用其中一方取代另一方。"
    },
    {
      "id": "risk.boundaries",
      "label": "风险与边界",
      "description": "说明哪些事情不得发生，以及哪些失败会造成高昂代价。",
      "perspectiveHint": "硬性禁令应由决策负责人或相关领域有权人员确认。"
    },
    {
      "id": "delivery.operations",
      "label": "交付与运维",
      "description": "明确托管、部署、维护与交接的预期。",
      "perspectiveHint": "将维护者的运维需求与开发者偏好的工作流程分别记录。"
    },
    {
      "id": "acceptance.validation",
      "label": "验收与验证",
      "description": "明确由谁验收，以及哪些证据足以判定完成。",
      "perspectiveHint": "最终决议应来自有权验收此次发行的个人或群体。"
    }
  ],
