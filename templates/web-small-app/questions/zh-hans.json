  "locale": "zh-hans",
  "direction": "ltr",
  "template": {
    "name": "网站与小型 Web 应用",
    "summary": "明确网站或边界清晰的 Web 应用的工作前提。"
  },
  "answerContext": {
    "answeringFrom": "回答来源",
    "recordedBy": "记录者",
    "speakingAs": "回答时的角色",
    "captureMethod": "信息获取方式",
    "authority": "此回答的权限",
    "confirmation": "来源确认状态",
    "changeForQuestion": "为此问题更改",
    "multiplePerspectives": "添加其他视角"
  },
  "resolutionStates": [
    {
      "value": "confirmed",
      "label": "已确认",
      "description": "将此内容作为已采纳的项目前提。"
    },
    {
      "value": "provisional",
      "label": "暂定",
      "description": "暂时采用，但明确保留修改的可能。"
    },
    {
      "value": "unspecified",
      "label": "未决定",
      "description": "保持未决。不得让 AI 擅自补全。"
    },
    {
      "value": "proposal_requested",
      "label": "请求提案",
      "description": "请求备选方案或建议，但不将其视为已选定。"
    },
    {
      "value": "delegated",
      "label": "在限定范围内委托",
      "description": "允许实施者或 AI 在规定范围内决定，并报告选择。"
    },
    {
      "value": "not_applicable",
      "label": "不适用",
      "description": "将此问题标记为不属于此项目。"
    }
  ],
  "messages": {
    "validation.provenanceRequired": "请选择回答代表谁的视角，以及由谁记录。",
    "validation.speakingRoleMismatch": "所选回答角色未分配给该参与者。",
    "validation.inferenceUnconfirmed": "推断所得的回答，在有权人员核实前必须保持未确认。",
